# Copy to .env (git-ignored). Use a READ-ONLY InfluxDB user: VibeDash never writes.
# Without local/mapping.json the server runs in demo mode and these are not needed.
INFLUX_URL=http://influxdb.example:8086
INFLUX_DB=example
INFLUX_USER=vibedash_read
INFLUX_PASSWORD=change-me
# INFLUX_RP=autogen
# MAPPING_PATH=local/mapping.json
# Only this machine by default. For the home network set HOST=0.0.0.0 (or the LAN address).
# HOST=0.0.0.0
# Extra names the browser may use (this machine's own name and addresses are allowed anyway):
# ALLOWED_HOSTS=dashboard.home
# LOCATION_WRITE=off   # location only from .env, no write endpoint
# PORT=8080

# Home Assistant (optional, can be combined with InfluxDB).
# Long-lived access token of a DEDICATED NON-ADMIN user (HA profile → Security).
# HA_URL=http://homeassistant.example:8123
# HA_TOKEN=change-me

# Weather forecast (Open-Meteo, no key). On by default; only the location
# rounded to about 1 km leaves the house. WEATHER=off disables every request.
# The location comes from LATITUDE/LONGITUDE, else local/settings.json (set once
# in the app), else Home Assistant's own location.
# evcc (optional): wallbox now + the charging sessions evcc stores itself.
# EVCC_URL=http://evcc.example:7070

# Forecasting service (Python, see forecast/). Only this server talks to it.
# FORECAST_URL=http://127.0.0.1:8090

# WEATHER=off
# LATITUDE=50.00
# LONGITUDE=8.00
