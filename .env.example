# Copy to .env (git-ignored). Use a READ-ONLY InfluxDB user: VibeDash never writes.
# Without local/mapping.json the server runs in demo mode and these are not needed.
INFLUX_URL=http://influxdb.example:8086
INFLUX_DB=example
INFLUX_USER=vibedash_read
INFLUX_PASSWORD=change-me
# INFLUX_RP=autogen
# MAPPING_PATH=local/mapping.json
# HOST=0.0.0.0
# PORT=8080
