# User unit for VibeDash (Audit01 C-04, S-05). Install:
#   cp deploy/vibedash.service ~/.config/systemd/user/ && systemctl --user daemon-reload
#   systemctl --user enable --now vibedash && loginctl enable-linger "$USER"
# Config (.env, local/mapping.json) lives in ~/.config/vibedash, releases in
# ~/.local/share/vibedash (scripts/release.sh). Node is expected on PATH or in
# ~/.local/opt/node; adjust ExecStart if it lives elsewhere.
[Unit]
Description=VibeDash (read-only house dashboard)
After=network-online.target
# a release that keeps failing stops after 5 tries in 5 min (no endless loop);
# scripts/release.sh notices it and goes back to the previous release
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
WorkingDirectory=%h/.config/vibedash
Environment=DIST_DIR=%h/.local/share/vibedash/current/dist
ExecStart=%h/.local/opt/node/bin/node %h/.local/share/vibedash/current/dist-server/main.js
Restart=on-failure
RestartSec=10
MemoryMax=768M
TasksMax=64
UMask=0077

# Hardening: no privilege gain (blocks sudo/setuid), read-only system, own /tmp,
# only network sockets. The home is hidden (Audit02 B-03): only the releases,
# Node and the config are mounted in, read-only; writable only local/ (settings).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=%h/.local/share/vibedash %h/.local/opt/node %h/.config/vibedash
BindPaths=%h/.config/vibedash/local
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK: to learn its own addresses for the Host check
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
